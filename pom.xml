<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent of the multi-module build (since 2026-10-09):
         - cow2win-app: the application itself - the only module that is packaged and
           shipped (fat jar, jpackage app-image, zip).
         - cow2win-datatool: the master data tool for src/main/resources of the app
           module - built and tested here, never shipped.
         Only shared settings live here; everything packaging-related stays in the app
         module's pom. -->
    <groupId>org.c2w</groupId>
    <artifactId>cow2win-parent</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>
    <name>Cow2Win (parent)</name>
    <description>An Assistant for Clash of world (Hero wars: Dominion Era)</description>

    <modules>
        <module>cow2win-app</module>
        <module>cow2win-datatool</module>
    </modules>

    <properties>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gson.version>2.13.2</gson.version>
        <junit.version>5.14.4</junit.version>
        <h2.version>2.5.252</h2.version>
        <material.ui.swing.version>1.1.2</material.ui.swing.version>
        <maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.github.vincenzopalazzo</groupId>
                <artifactId>material-ui-swing</artifactId>
                <version>${material.ui.swing.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Explicit version so Maven's default (which may not understand the JUnit
                     Platform) doesn't silently skip the tests. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
