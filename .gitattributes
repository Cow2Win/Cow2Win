# Line endings are fixed here for every machine and CI, independent of each
# developer's core.autocrlf: text files are LF in the repository and in the
# working copy.
* text=auto eol=lf

# Battle-log test data: keep byte-identical to the game's export (CRLF line
# endings) on every machine, including Linux CI - no newline conversion.
cow2win-app/src/test/resources/battlelog/**/*.csv -text
# The same for the demo battle logs imported on the first start.
cow2win-app/src/main/resources/data/demo-journal/*.csv -text

# Binary files
*.png binary
*.ico binary
# The game catalog (catalog/manifest.json lists every file's size and SHA-256):
# stored and checked out byte for byte, no newline conversion on any machine.
catalog/** -text
