# Editor settings shared by IntelliJ and other editors (see .gitattributes).
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true

# Battle-log test data: byte-identical to the game's export - never touch.
[src/test/resources/battlelog/**.csv]
end_of_line = crlf
insert_final_newline = unset
