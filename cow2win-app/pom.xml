<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The application module - the only module that is packaged and shipped. Java
         version, encoding and the dependency/Surefire versions come from the parent
         pom.xml in the repository root. -->
    <parent>
        <groupId>org.c2w</groupId>
        <artifactId>cow2win-parent</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>Cow2Win</artifactId>
    <packaging>jar</packaging>
    <name>Cow2Win</name>
    <description>An Assistant for Clash of world (Hero wars: Dominion Era)</description>
    <properties>
        <!-- Windows app-image packaging (bundled JRE + resources folder) - see the
             maven-shade-plugin/jpackage-maven-plugin/maven-assembly-plugin executions
             below and the "Distribution package" section in README.md. -->
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <maven.assembly.plugin.version>3.8.0</maven.assembly.plugin.version>
        <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
        <jpackage.maven.plugin.version>1.8.0</jpackage.maven.plugin.version>
        <app.mainClass>org.c2w.C2WApp</app.mainClass>
        <app.name>Cow2Win</app.name>
        <app.version>1.0.9</app.version>
        <app.vendor>org.c2w</app.vendor>
        <dist.skip>false</dist.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.vincenzopalazzo</groupId>
            <artifactId>material-ui-swing</artifactId>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>app-version.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>app-version.properties</include>
                </includes>
            </resource>
            <!-- The game catalog (heroes, titans, pets, war flags, fortifications and their
                 images, plus manifest.json) lives in the repository's catalog/ folder and is
                 built into the jar as /catalog/..., read only via org.c2w.infra.CatalogStore. -->
            <resource>
                <directory>${project.basedir}/../catalog</directory>
                <targetPath>catalog</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven.resources.plugin.version}</version>
                <executions>
                    <execution>
                        <id>stage-app-content-resources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/app-content/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <!-- Only meaningful on the classpath (filtered copy inside the
                                         jar, read by org.c2w.infra.AppVersion). This on-disk copy would
                                         be unfiltered, i.e. still show the literal "${app.version}"
                                         placeholder, and is never read - so leave it out. -->
                                    <excludes>
                                        <exclude>app-version.properties</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <id>build-executable-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                            <finalName>${app.name}</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${app.mainClass}</mainClass>
                                    <manifestEntries>
                                        <!-- H2 is a multi-release jar (META-INF/versions/21/...).
                                             The merged manifest is our own, so the flag has to be
                                             set again here or the versioned classes are ignored. -->
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>${jpackage.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>build-app-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <skip>${dist.skip}</skip>
                            <type>APP_IMAGE</type>
                            <name>${app.name}</name>
                            <appVersion>${app.version}</appVersion>
                            <vendor>${app.vendor}</vendor>
                            <description>${project.description}</description>
                            <input>${project.build.directory}/jpackage-input</input>
                            <mainJar>${app.name}.jar</mainJar>
                            <mainClass>${app.mainClass}</mainClass>
                            <destination>${project.build.directory}/dist</destination>
                            <removeDestination>true</removeDestination>
                            <winConsole>false</winConsole>
                            <!-- .ico for Cow2Win.exe / the app-image folder icon, generated from
                                 src/main/resources/images/app/cow.png (the same image used as the
                                 in-app frame icon, see Cow2Frame#FRAME_ICON_PATH). Without this,
                                 jpackage falls back to the default Java coffee-cup icon. -->
                            <icon>${project.basedir}/src/main/resources/images/app/cow.ico</icon>
                            <addModules>
                                <addModule>java.base</addModule>
                                <addModule>java.desktop</addModule>
                                <addModule>java.net.http</addModule>
                                <addModule>java.sql</addModule>
                                <addModule>java.naming</addModule>
                                <addModule>java.management</addModule>
                            </addModules>
                            <appContentPaths>
                                <appContentPath>${project.build.directory}/app-content/resources</appContentPath>
                            </appContentPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Zips target/dist/Cow2Win/ into target/Cow2Win-<version>-windows-app.zip
                 (descriptor: src/assembly/windows-app.xml) and attaches it as a secondary
                 artifact, so a plain `mvn deploy` uploads this distributable package -
                 JRE, app jar and resources folder together - to the repository in
                 distributionManagement below, not just the plain code jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven.assembly.plugin.version}</version>
                <executions>
                    <execution>
                        <id>zip-app-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <skipAssembly>${dist.skip}</skipAssembly>
                            <descriptors>
                                <descriptor>src/assembly/windows-app.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>true</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>local-repo</id>
            <url>file:///C:\Entwicklung\lokalesRepo</url>
        </repository>

        <snapshotRepository>
            <id>local-snapshots</id>
            <url>file:///C:\Entwicklung\snapshots</url>
        </snapshotRepository>
    </distributionManagement>

</project>
